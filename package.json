{
  "name": "msecrets-monorepo",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k18k/msecrets.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --test --test-timeout=120000 \"packages/*/test/**/*.test.ts\"",
    "test:dist": "node --test --test-timeout=120000 \"packages/*/test-dist/**/*.test.{mjs,cjs}\"",
    "coverage": "node --test --test-timeout=120000 --experimental-test-coverage --test-coverage-include=\"packages/*/src/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info \"packages/*/test/**/*.test.ts\"",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test && npm run test:dist && npm run verify:packages",
    "verify:packages": "node scripts/verify-packages.ts",
    "publish:new": "node scripts/publish.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "tsdown": "0.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "npm@12.2.0"
}
