{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build",
        "^test"
      ],
      "outputs": [],
      "inputs": [
        "**/*",
        "!.turbo/**",
        "!node_modules/**"
      ]
    },
  }
}