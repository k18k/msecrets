{
  "name": "@msecrets/adapters",
  "version": "2.0.2",
  "description": "Runtime decryption adapters for msecrets (GPG, Docker Secrets, raw PGP keys)",
  "keywords": [
    "adapter",
    "encryption",
    "secrets",
    "secrets-management"
  ],
  "license": "MIT",
  "author": "Krystian Mikołajczyk",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./docker-secrets": {
      "import": "./dist/docker-secrets.mjs",
      "require": "./dist/docker-secrets.cjs"
    },
    "./gpg": {
      "import": "./dist/gpg.mjs",
      "require": "./dist/gpg.cjs"
    },
    "./raw-pks": {
      "import": "./dist/raw-pks.mjs",
      "require": "./dist/raw-pks.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsdown"
  },
  "dependencies": {
    "node-rpgp": "^1.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "engineStrict": true
}
