{
  "name": "@msecrets/cli",
  "version": "3.0.0",
  "description": "CLI for managing repository-native encrypted secrets with PGP encryption.",
  "keywords": [
    "cli",
    "encryption",
    "secrets",
    "secrets-management"
  ],
  "license": "MIT",
  "author": "Krystian Mikołajczyk",
  "bin": {
    "msecrets": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.cts",
  "imports": {
    "#cli/*": "./src/*",
    "#commands/*": "./src/commands/*"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test:e2e": "node --test --test-timeout=60000 e2e.test.ts"
  },
  "devDependencies": {
    "@msecrets/core": "*",
    "commander": "^14.0.3",
    "inquirer": "^13.3.2"
  },
  "engines": {
    "node": ">=24"
  },
  "engineStrict": true,
  "inlinedDependencies": {
    "@inquirer/ansi": "2.0.5",
    "@inquirer/checkbox": "5.1.4",
    "@inquirer/confirm": "6.0.12",
    "@inquirer/core": "11.1.9",
    "@inquirer/editor": "5.1.1",
    "@inquirer/expand": "5.0.13",
    "@inquirer/external-editor": "3.0.0",
    "@inquirer/figures": "2.0.5",
    "@inquirer/input": "5.0.12",
    "@inquirer/number": "4.0.12",
    "@inquirer/password": "5.0.12",
    "@inquirer/rawlist": "5.2.8",
    "@inquirer/search": "4.1.8",
    "@inquirer/select": "5.1.4",
    "chardet": "2.1.1",
    "cli-width": "4.1.0",
    "commander": "14.0.3",
    "fast-string-truncated-width": "3.0.3",
    "fast-string-width": "3.0.2",
    "fast-wrap-ansi": "0.2.0",
    "iconv-lite": "0.7.2",
    "inquirer": "13.4.2",
    "mute-stream": "3.0.0",
    "openpgp": "6.3.0",
    "run-async": "4.0.6",
    "rxjs": "7.8.2",
    "safer-buffer": "2.1.2",
    "signal-exit": "4.1.0",
    "zod": "4.4.1"
  }
}
