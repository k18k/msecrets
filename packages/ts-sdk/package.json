{
  "name": "@msecrets/ts-sdk",
  "version": "4.0.0",
  "description": "Runtime SDK for msecrets: verify and decrypt the secrets committed in .env.ms.json. Zero dependencies.",
  "keywords": [
    "age",
    "dotenv",
    "encryption",
    "env",
    "post-quantum",
    "secrets",
    "secrets-management"
  ],
  "homepage": "https://k18k.github.io/msecrets/",
  "bugs": "https://github.com/k18k/msecrets/issues",
  "license": "MIT",
  "author": "Krystian Mikołajczyk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k18k/msecrets.git",
    "directory": "packages/ts-sdk"
  },
  "files": [
    "dist",
    "schema"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/register.mjs",
    "./dist/register.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./register": {
      "import": "./dist/register.mjs",
      "require": "./dist/register.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "engines": {
    "node": ">=20"
  }
}
