{
  "name": "@msecrets/ts-sdk",
  "version": "3.0.1",
  "description": "TypeScript SDK for runtime secret decryption with msecrets",
  "keywords": [
    "encryption",
    "openpgp",
    "sdk",
    "secrets",
    "secrets-management"
  ],
  "license": "MIT",
  "author": "Krystian Mikołajczyk",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./adapters/docker-secrets": {
      "import": "./dist/adapters/docker-secrets.mjs",
      "require": "./dist/adapters/docker-secrets.cjs"
    },
    "./adapters/gpg": {
      "import": "./dist/adapters/gpg.mjs",
      "require": "./dist/adapters/gpg.cjs"
    },
    "./adapters/raw-pks": {
      "import": "./dist/adapters/raw-pks.mjs",
      "require": "./dist/adapters/raw-pks.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node --watch --test e2e.test.ts",
    "test": "node --test --test-timeout=60000 **/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsdown"
  },
  "devDependencies": {
    "@msecrets/core": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "engineStrict": true,
  "inlinedDependencies": {
    "openpgp": "6.3.0",
    "zod": "4.4.1"
  }
}
