{
  "name": "@msecrets/core",
  "version": "3.0.1",
  "private": true,
  "description": "Core cryptographic primitives and shared logic for msecrets",
  "keywords": [
    "encryption",
    "git",
    "openpgp",
    "secrets",
    "secrets-management"
  ],
  "license": "MIT",
  "author": "Krystian Mikołajczyk",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#ms/*": "./src/*"
  },
  "exports": {
    "./adapters/docker-secrets": {
      "import": "./dist/adapters/docker-secrets.mjs",
      "require": "./dist/adapters/docker-secrets.cjs"
    },
    "./adapters/gpg": {
      "import": "./dist/adapters/gpg.mjs",
      "require": "./dist/adapters/gpg.cjs"
    },
    "./adapters/raw-pks": {
      "import": "./dist/adapters/raw-pks.mjs",
      "require": "./dist/adapters/raw-pks.cjs"
    },
    "./crypto": {
      "import": "./dist/crypto.mjs",
      "require": "./dist/crypto.cjs"
    },
    "./key-material": {
      "import": "./dist/key-material.mjs",
      "require": "./dist/key-material.cjs"
    },
    "./providers": {
      "import": "./dist/providers.mjs",
      "require": "./dist/providers.cjs"
    },
    "./runtime": {
      "import": "./dist/runtime.mjs",
      "require": "./dist/runtime.cjs"
    },
    "./secret-helpers": {
      "import": "./dist/secret-helpers.mjs",
      "require": "./dist/secret-helpers.cjs"
    },
    "./secrets-file": {
      "import": "./dist/secrets-file.mjs",
      "require": "./dist/secrets-file.cjs"
    },
    "./types": {
      "import": "./dist/types.mjs",
      "require": "./dist/types.cjs"
    },
    "./validation": {
      "import": "./dist/validation.mjs",
      "require": "./dist/validation.cjs"
    },
    "./workflows": {
      "import": "./dist/workflows.mjs",
      "require": "./dist/workflows.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsdown",
    "test": "node --test --test-timeout=60000 **/*.test.ts"
  },
  "devDependencies": {
    "openpgp": "^6.2.2",
    "zod": "4.4.1"
  },
  "engines": {
    "node": ">=24"
  },
  "engineStrict": true,
  "inlinedDependencies": {
    "openpgp": "6.3.0",
    "zod": "4.4.1"
  }
}
