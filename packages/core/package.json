{
  "name": "@msecrets/core",
  "version": "3.0.0",
  "private": true,
  "description": "Core cryptographic primitives and shared logic for msecrets",
  "keywords": [
    "encryption",
    "git",
    "openpgp",
    "secrets",
    "secrets-management"
  ],
  "license": "MIT",
  "author": "Krystian Mikołajczyk",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#ms/*": "./src/*"
  },
  "exports": {
    "./adapters/docker-secrets": {
      "import": "./src/adapters/docker-secrets.ts",
      "require": "./src/adapters/docker-secrets.ts"
    },
    "./adapters/gpg": {
      "import": "./src/adapters/gpg.ts",
      "require": "./src/adapters/gpg.ts"
    },
    "./adapters/raw-pks": {
      "import": "./src/adapters/raw-pks.ts",
      "require": "./src/adapters/raw-pks.ts"
    },
    "./crypto": {
      "import": "./src/crypto.ts",
      "require": "./src/crypto.ts"
    },
    "./key-material": {
      "import": "./src/key-material.ts",
      "require": "./src/key-material.ts"
    },
    "./providers": {
      "import": "./src/providers/index.ts",
      "require": "./src/providers/index.ts"
    },
    "./runtime": {
      "import": "./src/runtime.ts",
      "require": "./src/runtime.ts"
    },
    "./secret-helpers": {
      "import": "./src/secret-helpers.ts",
      "require": "./src/secret-helpers.ts"
    },
    "./secrets-file": {
      "import": "./src/secrets-file.ts",
      "require": "./src/secrets-file.ts"
    },
    "./types": {
      "import": "./src/types.ts",
      "require": "./src/types.ts"
    },
    "./validation": {
      "import": "./src/validation.ts",
      "require": "./src/validation.ts"
    },
    "./workflows": {
      "import": "./src/workflows.ts",
      "require": "./src/workflows.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsdown"
  },
  "devDependencies": {
    "openpgp": "^6.2.2",
    "zod": "4.4.1"
  },
  "engines": {
    "node": ">=24"
  },
  "engineStrict": true,
  "inlinedDependencies": {
    "openpgp": "6.3.0",
    "zod": "4.4.1"
  }
}
